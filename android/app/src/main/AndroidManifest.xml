<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
    ═══════════════════════════════════════════════════════════════════════
    LOCATION PERMISSIONS
    ═══════════════════════════════════════════════════════════════════════
    ACCESS_FINE_LOCATION   — required for GPS-precision geofence triggers
    ACCESS_COARSE_LOCATION — fallback when GPS unavailable; required for
                             ACCESS_FINE_LOCATION request on API 31+
    ACCESS_BACKGROUND_LOCATION — required on Android 10+ (API 29+) for
                             geofence monitoring when the app is not in the
                             foreground. App Store/Play Store note: must be
                             granted AFTER the user first grants foreground
                             location. This permission triggers an additional
                             system dialog on Android 11+ pointing users to
                             Settings to select "Allow all the time".
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!--
    ═══════════════════════════════════════════════════════════════════════
    FOREGROUND SERVICE
    ═══════════════════════════════════════════════════════════════════════
    Required on Android 8+ (API 26+) to keep the background geolocation
    tracking service alive. FOREGROUND_SERVICE_LOCATION is the granular
    type introduced in Android 14 (API 34) for Play Store compliance.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
    ═══════════════════════════════════════════════════════════════════════
    BOOT + WAKE LOCK
    ═══════════════════════════════════════════════════════════════════════
    RECEIVE_BOOT_COMPLETED — restart the geofence monitoring service after
                             device reboot (react-native-background-geolocation
                             startOnBoot: true option requires this).
    WAKE_LOCK              — prevents the CPU from sleeping mid-fix so the
                             headless JS task can complete its work.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
    POST_NOTIFICATIONS — required to show notification badges and alerts on
                         Android 13+ (API 33+). Request at runtime via
                         NotificationService.requestPermission().
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
        ═══════════════════════════════════════════════════════════════════
        LGGeofenceMonitor — Custom native geofencing module
        ═══════════════════════════════════════════════════════════════════
        LGGeofenceBroadcastReceiver receives ENTER/EXIT/DWELL transitions
        from Google Play Services GeofencingClient and forwards them to JS
        via DeviceEventEmitter ("LGGeofenceTransition" event).
        -->
        <receiver
            android:name=".LGGeofenceBroadcastReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.locus.GEOFENCE_TRANSITION" />
            </intent-filter>
        </receiver>

        <!--
        Notifee — required for background notification action handling
        (e.g. dismiss/snooze actions from the notification shade).
        -->
        <receiver
            android:name="io.invertase.notifee.NotifeeEventReceiver"
            android:exported="false"
            android:enabled="true" />

    </application>
</manifest>
